[Unit]
Description=Graywatch Linux degradation detector
Documentation=file://@GRAYWATCH_DOC@
After=local-fs.target

[Service]
Type=simple
User=graywatch
Group=graywatch
# Defaults; /etc/default/graywatch overrides them (see the comments there).
Environment=GRAYWATCH_KEEP=30m GRAYWATCH_MAX_SIZE=2G GRAYWATCH_OPTIONS=
EnvironmentFile=-/etc/default/graywatch
RuntimeDirectory=graywatch
RuntimeDirectoryMode=0750
LogsDirectory=graywatch
LogsDirectoryMode=0750
# Records every event to /var/log/graywatch for GRAYWATCH_KEEP, logs problem
# periods to /var/log/graywatch/changes.jsonl, and asks graywatch-capture.path
# for a collection when a problem lasts.
ExecStart=@GRAYWATCH_DAEMON@ --socket /run/graywatch/graywatchd.sock --top 20 --task-interval 5 --record-dir /var/log/graywatch --keep ${GRAYWATCH_KEEP} --max-size ${GRAYWATCH_MAX_SIZE} --capture-request /run/graywatch/capture-request $GRAYWATCH_OPTIONS
Restart=on-failure
RestartSec=2s
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
